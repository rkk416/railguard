# ==============================================================================
# RailGuard Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real credentials, service-role keys, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION BASE URL (Client-Safe & Server)
# ------------------------------------------------------------------------------
# Mandatory: Used for generating QR codes, canonical links, and redirect targets.
# In local development: http://localhost:3000
# In Render production: https://<your-service-name>.onrender.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (Private — Server-Side Only)
# ------------------------------------------------------------------------------
# Mandatory:
# Obtain from Supabase Dashboard:
# -> Project Settings -> Database -> Connection string -> URI
#
# DATABASE_URL:
#   Use the Supabase Session Pooler connection string (IPv4 compatible, Port 5432).
#   Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# DIRECT_URL:
#   Direct PostgreSQL connection string (Port 5432) used by Prisma migrate.
#   Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 3. SUPABASE PRIVATE STORAGE BUCKET (Private — Server-Side Only)
# ------------------------------------------------------------------------------
# Mandatory for production cloud deployment.
# Obtain from Supabase Dashboard:
# -> Project Settings -> API
#
# SUPABASE_URL: Project URL (e.g. https://[project-ref].supabase.co)
SUPABASE_URL="https://[project-ref].supabase.co"

# SUPABASE_SERVICE_ROLE_KEY:
#   CRITICAL: Use the secret `service_role` key (NOT the anon/public key).
#   Allows server-side code to write and read from private `railguard-evidence` bucket.
#   NEVER prefix this with NEXT_PUBLIC_ or expose to browser.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_STORAGE_BUCKET:
#   Name of the private bucket created in Supabase Dashboard -> Storage.
#   Default: railguard-evidence (must be marked Private / Non-Public).
SUPABASE_STORAGE_BUCKET="railguard-evidence"

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC & SESSION SECRETS (Private — Server-Side Only)
# ------------------------------------------------------------------------------
# Mandatory in production.
# On Render Blueprint, these are automatically generated if omitted.
# In local development, you can generate via: openssl rand -base64 32

# SESSION_SECRET: Used for signing and verifying server session cookies
SESSION_SECRET="your-32-char-random-secret-key-min-length"

# EVIDENCE_TOKEN_SECRET: Used for signing 15-minute passenger evidence access tokens
EVIDENCE_TOKEN_SECRET="your-32-char-random-evidence-token-secret"

# DEMO_RESET_ADMIN_SECRET: Bypass admin header key for automated test resets
DEMO_RESET_ADMIN_SECRET="your-32-char-random-demo-reset-admin-key"

# ------------------------------------------------------------------------------
# 5. SAFETY & OPERATIONAL GUARDS (Private — Server-Side Only)
# ------------------------------------------------------------------------------
# ALLOW_DEMO_RESET:
#   Set to "true" ONLY if you wish to allow resetting database to demonstration baseline.
#   Keep "false" in production to prevent accidental data wipes.
ALLOW_DEMO_RESET="false"

# NODE_ENV:
#   "development" for local work, "production" on Render.
NODE_ENV="development"
