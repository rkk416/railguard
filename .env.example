# RailGuard Environment Variables Example
# Duplicate this file to .env.local and populate with your local/deployment secrets.
# NEVER commit real credentials or secrets to version control.

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (e.g. Supabase or Local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/railguard?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/railguard?schema=public"

# Authentication
# In production, generate a secure 32+ character random secret (e.g., `openssl rand -base64 32`)
AUTH_SECRET="your-development-auth-secret-min-32-chars-long"

# Object Storage for Complaint Evidence (Private Supabase Storage or S3-compatible)
STORAGE_PROVIDER="supabase"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
STORAGE_BUCKET_NAME="railguard-evidence"

# Demonstration Mode Flags
NEXT_PUBLIC_DEMO_MODE="true"
